# CampusConnect environment variables — copy to .env.local (git-ignored) and fill in.
# Find the values in Supabase: Project Settings → API Keys (and Data API for the URL).
#
# Only the *publishable* key (sb_publishable_…) or the legacy *anon* public key belongs
# here: it is shipped to every browser and Row Level Security protects the data.
# NEVER put the service_role / sb_secret_… key in this file, in Vercel, or in any VITE_ variable.

# Used by the browser
VITE_SUPABASE_URL="https://YOUR-PROJECT-REF.supabase.co"
VITE_SUPABASE_PUBLISHABLE_KEY="sb_publishable_YOUR_KEY_OR_ANON_KEY"
VITE_SUPABASE_PROJECT_ID="YOUR-PROJECT-REF"

# Same values, used by server-side rendering
SUPABASE_URL="https://YOUR-PROJECT-REF.supabase.co"
SUPABASE_PUBLISHABLE_KEY="sb_publishable_YOUR_KEY_OR_ANON_KEY"
SUPABASE_PROJECT_ID="YOUR-PROJECT-REF"

# Optional: public URL encoded in QR passes, e.g. https://your-app.vercel.app (no trailing slash).
# Leave unset to use the address of the site the student registered on.
# VITE_PUBLIC_SITE_URL="https://your-app.vercel.app"

# Optional, only for `npx drizzle-kit migrate` from your computer. Keep it out of git.
# Supabase: Connect → Connection string (Session pooler or Direct).
# LOVABLE_DB_MIGRATION_URL="postgresql://postgres.YOUR-PROJECT-REF:PASSWORD@aws-0-REGION.pooler.supabase.com:5432/postgres"
