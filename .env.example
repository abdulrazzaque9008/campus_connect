# Copy to .env (or .env.local) and fill in. Never commit secret keys.
# Only *publishable* Supabase keys belong here — they are shipped to the browser.
# Do NOT put the service-role / sb_secret_ key in any VITE_ variable.

# Backend (Lovable Cloud / Supabase) — used by the browser bundle
VITE_SUPABASE_URL="https://YOUR-PROJECT-REF.supabase.co"
VITE_SUPABASE_PUBLISHABLE_KEY="sb_publishable_YOUR_KEY"
VITE_SUPABASE_PROJECT_ID="YOUR-PROJECT-REF"

# Same values, read by the server-side renderer
SUPABASE_URL="https://YOUR-PROJECT-REF.supabase.co"
SUPABASE_PUBLISHABLE_KEY="sb_publishable_YOUR_KEY"
SUPABASE_PROJECT_ID="YOUR-PROJECT-REF"

# Public URL encoded in QR entry passes, e.g. your published site (no trailing slash).
# If empty, the URL of the page the student registered on is used.
VITE_PUBLIC_SITE_URL="https://your-app.example.com"

# Only needed to run `npx drizzle-kit migrate` from your machine.
# A Postgres connection string with rights to alter the schema. Keep it out of git.
# LOVABLE_DB_MIGRATION_URL="postgresql://postgres:PASSWORD@db.YOUR-PROJECT-REF.supabase.co:5432/postgres"
